# Copy this file to .env and fill in your values

# Database (defaults to local SQLite for instant zero-config setup)
DATABASE_URL=sqlite+aiosqlite:///./debate.db
# For PostgreSQL (optional/production):
# DATABASE_URL=postgresql+psycopg://debate_user:debate_pass@localhost:5432/debate_db

# JWT Security
SECRET_KEY=debate-coach-ai-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Agentic AI Engine (Optional - will use Heuristic Fallback if not configured)
# For Google Gemini API (Recommended for live demos on any question):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# For OpenAI API / Compatible (Alternative):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Provider Selection: 'auto', 'gemini', 'openai', or 'heuristic'
AI_PROVIDER=auto

# Application
APP_NAME="DebateCoach AI"
FRONTEND_URL=http://localhost:5173
DEBUG=true
