DATABASE_URL=sqlite:///./debate_coach.db
SECRET_KEY=change_this_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
FRONTEND_BASE_URL=http://localhost:5173

# AI / LLM Configuration
# Set LLM_PROVIDER to "gemini" and paste your Google Gemini API key below:
LLM_PROVIDER=gemini
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash

# Optional OpenAI fallback (only used if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=15
LLM_MAX_CONTEXT_MESSAGES=20
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Presentation & Upload settings
PRESENTATION_UPLOAD_DIRECTORY=presentation_uploads
PRESENTATION_MAX_UPLOAD_BYTES=26214400

# Email settings
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_DEBUG_MODE=false
