# DebateAI Environment Configuration

# Database Configuration (SQLite default for zero-config; or PostgreSQL)
DATABASE_URL=sqlite:///./debateai.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/debateai

# JWT & Authentication Secret
JWT_SECRET=production-secure-debate-ai-jwt-secret-key-2026

# Large Language Model Providers (Dual Mode: if empty, high-fidelity local deterministic NLP agent runs)
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# File Storage Paths
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# Application Port
PORT=8000
