# JustiTalk Platform Environment Configuration

PROJECT_NAME=JustiTalk
API_V1_STR=/api
SECRET_KEY=justitalk-super-secret-jwt-key-for-debate-coach-ai-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL in production, SQLite fallback in dev)
DATABASE_URL=sqlite:///./justitalk.db
# For PostgreSQL: DATABASE_URL=postgresql://justitalk_user:justitalk_password@localhost:5432/justitalk_db

# OpenAI API Configuration (Optional: fallback heuristic NLP activates if unconfigured)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Uploads & Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
