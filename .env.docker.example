# Copy to .env next to docker-compose.yml to customise the stack. Everything here is optional:
# the defaults run a guest-only stack against the bundled Ollama service.

# Model pulled into the ollama service by the model-pull sidecar.
OLLAMA_MODEL=qwen3.5:4b

# Reuse an Ollama already running on the host instead of the container:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
#   docker compose up api web
# OLLAMA_BASE_URL=http://ollama:11434

# Build the API with local transcription for delivery review: EXTRAS=--extra stt
# EXTRAS=

# Accounts. Only VITE_ values are public (they ship in the browser bundle); never put a
# service-role key or secret here. Turn REQUIRE_AUTH on only after the Supabase values are set.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
REQUIRE_AUTH=false
