# Copy to .env next to docker-compose.yml to customize the stack. Configure Supabase below
# before starting the API; the defaults require signed-in accounts and use bundled Ollama.

# Model pulled into the ollama service by the model-pull sidecar.
OLLAMA_MODEL=qwen3.5:4b

# Reuse an Ollama already running on the host instead of the container:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
#   docker compose up api web
# OLLAMA_BASE_URL=http://ollama:11434

# Laya is an optional local checkpoint. To opt in, set EXTRAS=--extra laya and
# ENABLE_LAYA_TACTICS=true, then rebuild the API image.
EXTRAS=
ENABLE_LAYA_TACTICS=false

# Accounts. Only VITE_ values are public (they ship in the browser bundle); never put a
# service-role key or secret here. Configure Supabase before starting the authenticated API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
REQUIRE_AUTH=true
