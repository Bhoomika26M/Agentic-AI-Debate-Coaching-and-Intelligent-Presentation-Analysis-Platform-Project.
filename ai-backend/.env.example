# Set LLM_PROVIDER=openai (or provide OPENAI_API_KEY and leave this on auto) to run
# deployed against any OpenAI-compatible endpoint. With auto and no key, Ollama is used.
LLM_PROVIDER=auto
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# json_schema (OpenAI) or json_object for providers without structured outputs.
OPENAI_JSON_MODE=json_schema
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
WEB_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
MAX_ACTIVE_STREAMS=2
PLANNER_EVERY_N_TURNS=2
# Optional local checkpoint; the built-in argument policy works without it.
ENABLE_LAYA_TACTICS=false
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
REQUIRE_AUTH=false
DEPLOYMENT_ENV=local
RATE_LIMIT_PER_MINUTE=60
MODEL_RATE_LIMIT_PER_MINUTE=12
STT_MODEL=distil-large-v3.5
STT_DEVICE=cpu
STT_COMPUTE_TYPE=
STT_LANGUAGE=en
STT_BEAM_SIZE=5
STT_VAD=false
MAX_AUDIO_MB=10
MAX_AUDIO_SEC=180
MAX_TRANSCRIBE_SEC=240
ENABLE_SER=false
SCRUB_LLM=false
LOG_LEVEL=INFO
