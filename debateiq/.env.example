# DebateIQ Environment Configuration

# Application
PROJECT_NAME="DebateIQ"
PROJECT_VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"

# Database Configuration
# Default to SQLite for zero-setup local dev. Set USE_SQLITE=false to use PostgreSQL.
USE_SQLITE=true
DATABASE_URL="sqlite:///./debateiq.db"
# POSTGRES_URL="postgresql://debateiq:debateiq_secret@localhost:5432/debateiq_db"

# Security & JWT Tokens
JWT_SECRET_KEY="debateiq-super-secure-production-jwt-token-key-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth2 (Optional for live SSO, mocked by default)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI & LLM Provider Configuration
# Set to 'mock' for 100% offline deterministic test/demo mode (default)
# Set to 'gemini' for live Gemini API reasoning
LLM_PROVIDER="mock"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Weighted Scoring Engine Constants
WEIGHT_ARGUMENT_QUALITY=0.30
WEIGHT_EVIDENCE_USAGE=0.20
WEIGHT_LOGICAL_CONSISTENCY=0.20
WEIGHT_REBUTTAL_EFFECTIVENESS=0.15
WEIGHT_COMMUNICATION_SKILLS=0.15

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173","*"]
